<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputName>StorageChronicle</OutputName>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>none</DebugType>
    <AgentSource Condition="'$(AgentSource)' == ''">$(MSBuildProjectDirectory)\StorageChronicle.wixproj</AgentSource>
    <SessionAgentSource Condition="'$(SessionAgentSource)' == ''">$(MSBuildProjectDirectory)\StorageChronicle.wxs</SessionAgentSource>
    <UiSource Condition="'$(UiSource)' == ''">$(MSBuildProjectDirectory)\..\TOP_CODEX.md</UiSource>
    <DefineConstants>ProductVersion=1.0.0;AgentSource=$(AgentSource);SessionAgentSource=$(SessionAgentSource);UiSource=$(UiSource)</DefineConstants>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="WixToolset.Util.wixext" /></ItemGroup>
</Project>
